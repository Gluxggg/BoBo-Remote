# 构建缓存与产物：体积大且可复现，不入库（由 build.ps1 重新获取并校验）
.cache/
dist/
.qa/

# 本机运行/调试痕迹
*.log
nul

# 编译输出
ci-out/
release-assets/
native/bobo-core/out/
native/bobo-tsnet/out/
native/bobo-stream-player/out/
native/bobo-stream-player/build/
native/bobo-stream-player/third_party/
*.exe
*.pdb
*.obj

# Android & Apple 构建缓存与产物
android/.gradle/
android/build/
android/app/build/
android/local.properties
apple/**/.build/
apple/**/.swiftpm/
apple/BoBoRemoteiOS/build/
apple/BoBoRemoteiOS/*.xcodeproj/
dist-apple/
dist-android/
ci-out-*/
one-sku-study.zip

# 环境变量与本地密钥（隔离上传与上下文读取）
.env
.env.*
*.env
!.env.example
!.env.template

# 证书、私钥、签名仓库与 SSH 密钥
*.pem
*.key
*.p12
*.pfx
*.p8
*.crt
*.cer
*.der
*.jks
*.keystore
*.mobileprovision
id_rsa*
id_ed25519*

# 敏感配置与凭据文件
*secret*.json
*secret*.yaml
*secret*.yml
*secrets*.json
*credential*.json
*credentials*.json
service-account*.json
google-services.json
GoogleService-Info.plist
ExportOptions*.plist
*.tfvars
*.tfvars.json
.npmrc
.pypirc
.antigravityignore
